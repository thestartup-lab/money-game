{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "dist/socketServer.js"
      ],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "backend-fast",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AUTO_HOST_TIME_SCALE=0.004",
        "AUTO_HOST_TICK_MS=40",
        "PERSIST_ROOMS=0",
        "node",
        "dist/socketServer.js"
      ],
      "port": 3001
    }
  ]
}